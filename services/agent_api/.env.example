# Gemini/OpenAI example:
LLM_API_KEY=replace-me
LLM_MODEL=openai:gpt-5.4-mini
LLM_TIMEOUT_SECONDS=300
REDIS_URL=redis://localhost:6379
CHECKPOINT_TTL_MINUTES=1440

# Must match the Google OAuth client ID configured in OAuth2 Proxy:
OIDC_AUDIENCE=replace-me.apps.googleusercontent.com
# OIDC_ISSUER=https://accounts.google.com
# OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Local Ollama alternative (LLM_API_KEY is not required):
# LLM_MODEL=ollama:devstral
# OLLAMA_BASE_URL=http://localhost:11434

JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=replace-me

GITHUB_API_TOKEN=replace-me
GITHUB_REPOSITORY=owner/repository

TAVILY_API_KEY=tvly-replace-me
