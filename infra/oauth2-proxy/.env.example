OAUTH2_PROXY_CLIENT_ID=replace-me.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=replace-with-a-base64url-cookie-secret
OAUTH2_PROXY_EMAIL_DOMAINS=your-company.example

# Local validation through Caddy:
OAUTH2_PROXY_REDIRECT_URL=http://localhost/oauth2/callback
OAUTH2_PROXY_COOKIE_SECURE=false

# With Caddy and HTTPS, use these values instead:
# OAUTH2_PROXY_REDIRECT_URL=https://assistant.example.com/oauth2/callback
# OAUTH2_PROXY_COOKIE_SECURE=true
